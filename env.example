# ==========================================================
#  Zenith Panel - Environment configuration
#  Copy to .env (the installer does this automatically)
# ==========================================================

# --- Panel ---
PANEL_NAME="Zenith Panel"
# Public URL used in install/claim messages (no trailing slash)
PANEL_URL="http://localhost:8080"
PORT=8080
HOST=0.0.0.0

# --- Security ---
# CHANGE THIS. The installer generates a random one for you.
JWT_SECRET="change-me-to-a-long-random-string"
# Token lifetime
JWT_EXPIRES="7d"
# Allow public self-registration of user accounts (true/false)
ALLOW_REGISTRATION=false
# Installer secret: `install.sh` registers the local node over the panel API
# before any browser exists. 32+ random characters; blank it to disable the
# path entirely (the installer then registers through an API key instead).
OWNER_SECRET=""
# Login brute-force protection
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=900000

# --- Optional Discord OAuth sign-in fallback --------------------------------
# Normally configure Discord OAuth in Administration → Panel settings. These
# environment values are a server-only alternative for immutable deployments.
DISCORD_OAUTH_CLIENT_ID=""
DISCORD_OAUTH_CLIENT_SECRET=""

# --- Storage ---
DATA_DIR="./data"
SERVER_DATA_DIR="./servers"
BACKUP_DIR="./backups"
# Max upload size for file manager / world uploads (bytes)
MAX_UPLOAD_SIZE=5368709120

# --- Runtime ---
# Path to the java binary used when a server does not pin its own runtime
JAVA_BIN="java"
# Where panel-managed JREs are installed by the runtime installer
# Managed Java runtimes (50-160 MB each). Keep them OUT of the project folder:
# the installer defaults to /var/lib/zenith/java (root) or ~/.zenith/java.
JAVA_DIR="./data/java"
# Seconds to wait after SIGTERM before SIGKILL on stop
STOP_TIMEOUT=20
# Rolling console buffer length kept in memory per server
LOG_BUFFER_LINES=3000
# Automatically start servers marked `autoStart` when the panel boots
AUTOSTART_SERVERS=true

# --- Modrinth ---
MODRINTH_API="https://api.modrinth.com/v2"
# Contact e-mail/url sent in the User-Agent (Modrinth asks for this)
MODRINTH_USER_AGENT="zenith-panel/1.0.0 (self-hosted)"

# --- playit.gg ---
PLAYIT_BIN_DIR="./data/bin"
# Optional: a global playit secret key shared by every server (leave empty for per-server claim links)
PLAYIT_GLOBAL_SECRET=""

# --- Server runtime ---------------------------------------------------------
# process = each server is a java child process of the panel
# docker  = each server runs in its own container (needs Docker on the node)
# Nodes can override this individually; this is the panel-wide default.
NODE_RUNTIME=process
# Leave blank when the panel and Docker daemon run on the same host. When the
# panel runs inside Docker but controls the host daemon socket, set this to the
# absolute HOST path that backs SERVER_DATA_DIR (e.g. /srv/zenith/servers).
# It is used only for the managed workload's /data bind mount.
DOCKER_BIND_ROOT=""
# Optional comma-separated DNS resolvers applied to isolated Docker workloads.
# Leave blank to copy real non-loopback resolvers from the panel host's
# /etc/resolv.conf. Use this only when a hosted Docker engine's user bridges
# cannot resolve names (for example: DOCKER_WORKLOAD_DNS="1.1.1.1,8.8.8.8").
DOCKER_WORKLOAD_DNS=""
# Optional account credentials for SteamCMD apps that publishers do not allow
# anonymous installs for (currently Terraria and Starbound in the game catalogue).
# Keep them only in the trusted panel service environment; they are forwarded to
# a short-lived installer container and are never stored in a server record.
STEAMCMD_USER=""
STEAMCMD_PASSWORD=""
# Optional UID:GID used by SteamCMD/game Docker containers when the panel data
# directory is not writable by the image's default steam user (UID 1000).
# Example on a host install: DOCKER_GAME_UID="$(id -u):$(id -g)"
DOCKER_GAME_UID=""

# --- SFTP ------------------------------------------------------------------
# A real SSH/SFTP server so users can reach their server files with FileZilla,
# WinSCP, Cyberduck or `sftp`. Login is <panel user>.<server id> + panel password
# (or an API key). Chrooted per server. Needs the optional ssh2 package.
SFTP_ENABLED=true
SFTP_PORT=2022
# Optional: the hostname shown in the UI when it cannot be detected
SFTP_HOST=""

# --- Nodes (optional remote agents) ---
# Shared secret a remote node agent must present to register with the panel
NODE_SECRET=""
