{
  "name": "zenith-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Zenith Panel - a Pterodactyl-style Minecraft server hosting panel (Node.js backend) with Modrinth plugin installs, playit.gg tunnels, subdomains, one-click player actions, host analytics and a Discord bot.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "createuser": "node scripts/createuser.js",
    "postinstall": "node scripts/postinstall.js",
    "pack": "node scripts/package.js",
    "pack:verify": "node scripts/package.js --verify",
    "size": "node tests/size-check.js",
    "verify": "bash tests/run.sh",
    "verify:api": "node scripts/smoke.js",
    "verify:ui": "node scripts/uitest.js",
    "verify:pages": "node tests/pages-panel.js",
    "verify:theme": "node tests/pages-theme.js",
    "verify:mods": "node tests/pages-mods-components.js",
    "verify:compress": "node tests/compression.js",
    "verify:size": "node tests/size-check.js",
    "verify:runtime": "node tests/runtime-api.js",
    "verify:installer": "bash tests/installer-node-check.sh",
    "verify:install": "npm install --no-save --no-audit --no-fund jsdom",
    "smoke": "node scripts/smoke.js",
    "uitest": "node scripts/uitest.js",
    "preview": "node scripts/theme-preview.js",
    "test": "bash tests/run.sh"
  },
  "keywords": [
    "minecraft",
    "panel",
    "pterodactyl",
    "hosting",
    "modrinth",
    "playit",
    "discord",
    "dns",
    "cloudflare",
    "analytics"
  ],
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  }
}
